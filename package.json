{
  "name": "quix-hw",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/fixtures",
    "apps/proto"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "node node_modules/eslint/bin/eslint.js . && node node_modules/prettier/bin/prettier.cjs --check .",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w apps/proto",
    "coverage": "npm run coverage -w packages/core"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.10.1",
    "typescript": "~5.6",
    "typescript-eslint": "^8.72.2",
    "vitest": "^2.1.9"
  }
}
